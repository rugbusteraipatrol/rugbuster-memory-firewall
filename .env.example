RUGBUSTER_MEMORY_DB=./runtime-memory.db
# Optional startup seed for the committed, independently re-verifiable AVAX case.
RUGBUSTER_SEED_VERIFIED_CASE=
# Optional; Routescan's free tier is keyless.
ROUTESCAN_API_KEY=
# Base Sepolia defaults to the official public RPC. Store the signing key with
# `npx hardhat keystore set BASE_SEPOLIA_PRIVATE_KEY`, never in this file.
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
BASE_RECEIPT_REGISTRY=0x5F30276B3A5079E088Ec3072884286de5a868355

# Optional production x402 endpoint. Use Base mainnet for a real paid pilot.
RUGBUSTER_X402_ENABLED=false
RUGBUSTER_X402_NETWORK=eip155:8453
RUGBUSTER_X402_PRICE=$0.01
RUGBUSTER_X402_PAY_TO=
RUGBUSTER_X402_RESOURCE_URL=https://your-public-api.example
RUGBUSTER_X402_SETTLEMENT_LOG=runtime/x402-settlements.jsonl
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
